{
  "manifest_version": 3,
  "name": "Highlight Links",
  "version": "1.1",
  "description": "Toggle highlight of clickable links on the page by clicking the extension icon.",
  "permissions": ["scripting", "activeTab"],
  "action": {
  "default_title": "LinkLighter",
  "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
},
  "background": {
    "service_worker": "background.js"
  }
}
